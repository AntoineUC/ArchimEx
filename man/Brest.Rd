\name{Brest}
\alias{Brest}
\docType{data}
\title{
Rainfalls in Brest, France
}
\description{
Daily  precipitations  recorded  in  Brest (France) between 1950 and 2023.
}
\usage{data("Brest")}
\format{
  A data frame with 6,903 observations of the following 3 variables.
  \describe{
    \item{\code{YYYYMMDD}}{Date (Year, month and day).}
    \item{\code{DRR}}{Duration (in mn) of daily rainfall.}
    \item{\code{RR}}{Amount (in mm) of daily rainfall.}
  }
}
\details{
The records are those of the Brest-Guipavas station.
}
\source{
Meteo France
}
\references{
Girard, S., Stupfler, G. and Usseglio-Carleve, A. Extremal regression in Archimedean copula models.
}

\keyword{datasets}
